<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain native layout (not React/webview) for the full-screen ring
  screen — it has to work even if the JS engine never boots (e.g. the
  webview is slow to cold-start while the phone is asleep), so it can't
  depend on anything from src/. Colors are hand-matched to the wood/
  paper "card catalog" palette in src/styles/tokens.css so it doesn't
  feel like a different app when it appears.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2A1D16"
    android:gravity="center_horizontal"
    android:paddingLeft="32dp"
    android:paddingRight="32dp"
    android:paddingTop="64dp"
    android:paddingBottom="48dp">

    <TextView
        android:id="@+id/alarm_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REMINDER"
        android:textColor="#B17F21"
        android:textSize="13sp"
        android:letterSpacing="0.12"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:text="Reminder"
        android:textColor="#F1E8CA"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:text=""
        android:textColor="#C9BC9C"
        android:textSize="16sp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/alarm_btn_done"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="#2C6B57"
        android:text="Mark done"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/alarm_btn_snooze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="#3B2A20"
        android:text="Snooze 1h"
        android:textAllCaps="false"
        android:textColor="#F1E8CA"
        android:textSize="16sp" />

    <Button
        android:id="@+id/alarm_btn_dismiss"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:text="Dismiss"
        android:textAllCaps="false"
        android:textColor="#8A7D64"
        android:textSize="14sp" />

</LinearLayout>
